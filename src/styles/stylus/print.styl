@page
  size A4
  margin 0

body.print
  min-width 0
  .container
    width 1080px
    position relative
    background-color #00bfa5
    margin 0
    clearfix()
  .sidebar
    width 310px
    padding 20px
    margin-bottom 0
    position relative
    float left
  .title
    margin 14px 0 18px
  .title img
    width 125px !important
    height 125px !important
    margin-bottom 8px !important
  .title h1
    font-size 24px
    line-height 30px
  .title h2
    font-size 13px
    line-height 18px
  .side-info li
    padding-top 14px
  .side-info dt
    font-size 18px
    line-height 28px
  .side-info dd
    font-size 14px
    line-height 20px
  .someRight dd
    margin-left 18px
    font-size 14px
    line-height 20px
  .skill-name
    width 96px
    margin-left 12px
    margin-right 6px
    font-size 13px
  .skill-bar-wrap
    height 14px
    width 122px
  .skill-bar
    height 14px
  .note
    margin-top 60px
    font-size 16px
  .main
    position relative
    float right
    left 0
    width 770px
    padding 10px 18px
    box-sizing border-box
  .main-info > li
    padding-top 7px
  .main-info dt
    font-size 22px
    line-height 27px
    margin 0 0 10px -5px
  .main-info dd
    font-size 14px
    line-height 22px
  .main-info span
    font-size 15px
  h2
    font-size 19px
    line-height 24px
    &.exp-title
      margin 7px 0
  h3
    font-size 18px
    margin 0 0 10px 5px
  h4
    font-size 16px
    line-height 23.3px
    bottom 2px
  h4 a,
  h5 a
    font-size 12px
    padding 0 3px
  h5
    font-size 16px
    line-height 22px
  .circle
    height 12px
    width 12px
    left -25px
    top 5px
  .exp
    border-left 2px solid #00796b
    margin-left 13px
  .skill .exp
    border-left 0
    & li
      list-style circle
      margin-top 5.5px
  .exp p
    font-size 13.5px
    line-height 20.3px
    margin-bottom 1px
  .experience p
    text-indent 16px
  .exp > li
    margin 7.5px 0 0 19px
    top -3px
  .exp img
    width 120px !important
    float right !important
    margin 0 0 4px 10px !important
  .exp ul > li
    margin 0 0 3px 0
  .efe .task4img
    height 65px
  footer
    display none
