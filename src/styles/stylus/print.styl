// Preserve a readable type size; let the browser paginate instead of shrinking.
@css {
  @page {
    size: A4;
    margin: 12mm 13mm;
  }

  body.print {
    min-width: 0;
    margin: 0;
    background: #fff;
    color: #222;
    font-size: 10.5pt;
    line-height: 1.45;
  }
  body.print .site {
    position: static;
    width: auto;
    margin: 0;
  }
  body.print .container {
    position: static;
    width: 184mm;
    max-width: 100%;
    margin: 0 auto;
    padding: 0;
    background: #fff;
    box-shadow: none;
    border-radius: 0;
    box-sizing: border-box;
  }
  body.print .sidebar,
  body.print .main {
    position: static;
    float: none;
    width: auto;
    padding: 0;
    background: #fff;
    color: #222;
    box-sizing: border-box;
  }
  body.print .sidebar { margin-bottom: 3mm; }
  body.print .title { margin: 0 0 4mm; text-align: left; }
  body.print .title img,
  body.print .exp img,
  body.print .circle,
  body.print .fa,
  body.print footer { display: none !important; }
  body.print .title h1 { font-size: 21pt; line-height: 1.2; font-weight: 700; }
  body.print .title h2 { font-size: 10.5pt; line-height: 1.45; color: #222; }
  body.print .side-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 7mm;
    row-gap: 2.5mm;
  }
  body.print .side-info > li { padding-top: 0; break-inside: avoid; }
  body.print .profile-basic { grid-column: 1; grid-row: 1 / 4; }
  body.print .profile-contact,
  body.print .profile-role,
  body.print .profile-honors { grid-column: 2; }
  body.print .profile-influence { grid-column: 1 / -1; }
  body.print .profile-honors br,
  body.print .profile-influence br { display: none; }
  body.print .profile-influence a::after { content: ": "; }
  body.print .profile-honors dd { margin-bottom: 1mm; }
  body.print .side-info dt {
    font-size: 11pt;
    line-height: 1.4;
    font-weight: 700;
    color: #222;
    margin-bottom: 1mm;
  }
  body.print .side-info dd,
  body.print .someRight dd,
  body.print .profile-value,
  body.print .education-detail,
  body.print .education-heading strong,
  body.print .education-heading span {
    margin-left: 0;
    font-size: 10.5pt;
    line-height: 1.4;
    opacity: 1;
  }
  body.print .education-item { padding: 1mm 0; border-color: #ddd; }
  body.print .education-list { margin-top: 1mm; }
  body.print .profile-row { margin-top: 1mm; align-items: baseline; }
  body.print .profile-label { padding: 0; border: 0; font-size: 10.5pt; opacity: 1; }
  body.print .note { margin-top: 3mm; color: #222; font-size: 10.5pt; }
  body.print .main-info > li { padding-top: 0; }
  body.print .main-info dt {
    margin: 0 0 2mm;
    font-size: 13pt;
    line-height: 1.4;
    color: #222;
    border-color: #777;
  }
  body.print h2.exp-title { margin: 2mm 0; font-size: 12pt; line-height: 1.4; color: #222; }
  body.print h4 { position: static; font-size: 11pt; line-height: 1.45; margin-bottom: 1mm; }
  body.print .main-info span { font-size: 10.5pt; }
  body.print .exp { margin-left: 0; border-left: 0; }
  body.print .exp > li { position: static; margin: 0 0 2mm; }
  body.print .exp ul > li { margin: 0 0 2mm; }
  body.print .project-item { break-inside: avoid; page-break-inside: avoid; }
  body.print .exp p { margin: 0 0 1mm; font-size: 10.5pt; line-height: 1.45; color: #222; }
  body.print .experience p { text-indent: 0; }
  body.print .skill .exp > li { list-style: none; margin: 0 0 1mm; }
  body.print a { color: #222; overflow-wrap: anywhere; }
  body.print h4 a { font-size: 9.5pt; padding: 0; border: 0; text-decoration: underline; }
  body.print dt,
  body.print h2,
  body.print h4 { break-after: avoid; page-break-after: avoid; }
  body.print p { orphans: 3; widows: 3; }

  @media screen {
    body.print { padding: 10mm; }
  }
  @media print {
    html, body { height: auto; overflow: visible; }
    body.print .container { width: 100%; max-width: none; margin: 0; }
    body.print { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
}
